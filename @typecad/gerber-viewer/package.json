{
  "name": "@typecad/gerber-viewer",
  "version": "0.2.0-alpha.0",
  "description": "Zero-dependency Gerber (RS-274X) + Excellon drill viewer for typeCAD boards - parse fab outputs and render an interactive SVG/HTML viewer",
  "keywords": [
    "typecad-package",
    "typecad",
    "gerber",
    "rs-274x",
    "excellon",
    "pcb",
    "viewer",
    "svg"
  ],
  "author": "typeCAD",
  "license": "EULA",
  "homepage": "https://typecad.net",
  "funding": "https://www.buymeacoffee.com/typecad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typecad/typecad.git",
    "directory": "@typecad/gerber-viewer"
  },
  "bin": {
    "gerber-viewer": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "package_publish": "npm publish --access public"
  }
}
