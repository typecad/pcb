{
  "name": "@typecad/jlcpcb-export",
  "version": "2.0.1-alpha.0",
  "description": "CLI tool to generate all files needed for JLCPCB assembly from a typeCAD project",
  "keywords": [
    "typecad-package",
    "typecad",
    "jlcpcb",
    "export",
    "pcb",
    "assembly",
    "bom",
    "cpl"
  ],
  "author": "typeCAD",
  "license": "EULA",
  "homepage": "https://typecad.net",
  "funding": "https://www.buymeacoffee.com/typecad",
  "bin": {
    "jlcpcb-export": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "replace-in-file": "^9.0.0",
    "zip-a-folder": "^6.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "package_publish": "npm publish --access public"
  }
}
