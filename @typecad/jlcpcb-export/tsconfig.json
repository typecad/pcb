{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "typeRoots": ["./node_modules/@types", "./types"],
    "paths": {
      "fast-sexpr": ["./types/fast-sexpr.d.ts"],
      "s-expression.js": ["./types/s-expression.js.d.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
