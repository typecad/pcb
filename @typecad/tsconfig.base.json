{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,

    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "sourceMap": true,
    "removeComments": false
  },
  "exclude": ["node_modules", "dist"]
}
