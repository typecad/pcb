{
  "name": "@typecad/typecad-docgen",
  "version": "1.0.3",
  "description": "Documentation generator for typeCAD PCB designs",
  "keywords": [
    "typecad",
    "pcb",
    "documentation",
    "markdown",
    "kicad"
  ],
  "author": "typeCAD",
  "license": "MIT",
  "homepage": "https://typecad.net",
  "funding": "https://www.buymeacoffee.com/typecad",
  "main": "dist/core.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "typecad-docgen": "./dist/index.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@hackmd/markdown-it-task-lists": "^2.1.4",
    "@shikijs/markdown-it": "^4.1.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "@typecad/typecad": "^0.2.30",
    "markdown-it": "^14.1.1",
    "markdown-it-attrs": "^4.5.0",
    "markdown-it-math": "^5.2.1",
    "markdown-it-multimd-table-ext": "^4.2.35",
    "markdown-it-textual-uml": "^0.17.1",
    "mathup": "^1.0.0",
    "temml": "^0.11.11"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:doc": "node dist/index.js test/fixtures/one_hz.md test/fixtures/one_hz.kicad_pcb -o test/fixtures/one_hz_output.html --no-open",
    "package_publish": "npm publish --access public"
  }
}
