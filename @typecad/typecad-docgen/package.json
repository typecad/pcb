{
  "name": "@typecad/typecad-docgen",
  "version": "1.0.3",
  "description": "Documentation generator for typeCAD PCB designs",
  "keywords": [
    "typecad",
    "pcb",
    "documentation",
    "markdown",
    "kicad"
  ],
  "author": "typeCAD",
  "license": "EULA",
  "homepage": "https://typecad.net",
  "funding": "https://www.buymeacoffee.com/typecad",
  "main": "dist/index.js",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "typecad-docgen": "./dist/index.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@hackmd/markdown-it-task-lists": "^2.1.4",
    "@shikijs/markdown-it": "^4.1.0",
    "@xmldom/xmldom": "^0.9.10",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "@typecad/typecad": "^0.2.30",
    "markdown-it": "^14.1.1",
    "markdown-it-attrs": "^4.5.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-math": "^5.2.1",
    "markdown-it-multimd-table-ext": "^4.2.35",
    "markdown-it-named-code-blocks": "^1.1.0",
    "markdown-it-textual-uml": "^0.17.1",
    "mathup": "^1.0.0",
    "open": "^11.0.0",
    "sharp": "^0.34.5",
    "temml": "^0.11.11",
    "uuid": "^14.0.0",
    "yocto-spinner": "^1.2.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node dist/index.js test/fixtures/one_hz.md test/fixtures/one_hz.kicad_pcb --no-open",
    "package_publish": "npm publish --access public",
    "publish:private": "npm publish --tag private --registry http://192.168.2.207:4873/"
  }
}
