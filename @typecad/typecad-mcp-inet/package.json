{
  "name": "@typecad/typecad-mcp-inet",
  "version": "0.2.3",
  "description": "MCP server for typeCAD with internet access",
  "main": "dist/web-server.js",
  "type": "module",
  "author": "typeCAD",
  "license": "MIT",
  "homepage": "https://typecad.net",
  "funding": "https://www.buymeacoffee.com/typecad",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "typecad-mcp": "dist/web-server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/web-server.js",
    "dev": "ts-node src/web-server.ts",
    "test": "vitest run",
    "watch": "tsc --watch",
    "dev:watch": "nodemon --watch src --ext ts,json --exec \"npm run build && npm run start\"",
    "package_publish": "npm publish --access public",
    "publish:private": "npm publish --tag private --registry http://192.168.2.207:4873/"
  },
  "dependencies": {
    "pdfreader": "^3.0.7",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.5",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.1"
  },
  "keywords": [
    "mcp",
    "server",
    "ai",
    "llm"
  ]
}
