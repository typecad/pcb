{
  "name": "@typecad/typecad",
  "version": "0.2.30",
  "description": "🤖programmatically 💥create 🛰️hardware",
  "keywords": [
    "kicad",
    "typescript",
    "schematic",
    "ee",
    "electrical design",
    "code-as-schematic",
    "typecad"
  ],
  "homepage": "https://typecad.net",
  "funding": "https://www.buymeacoffee.com/typecad",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "create-typecad": "./dist/cli/create-typecad/index.js",
    "add-component": "./dist/cli/add-component/index.js",
    "add-package": "./dist/cli/add-package/index.js",
    "kicad-symbols": "./dist/kicad-symbols/cli/bin.js",
    "kicad2typecad": "./dist/kicad2typecad/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "create-typecad": "node ./dist/cli/create-typecad/index.js",
    "add-component": "node ./dist/cli/add-component/index.js",
    "add-package": "node ./dist/cli/add-package/index.js",
    "build": "tsc && tsc -p tsconfig.cli.json",
    "typecheck": "tsc --noEmit",
    "obfuscate": "javascript-obfuscator dist --output dist-obfuscated --config obfuscator.config.json",
    "obfuscate:strong": "javascript-obfuscator dist --output dist-obfuscated --config obfuscator.strong.config.json",
    "copy-files": "cpy \"dist-obfuscated/**/*\" dist --parents",
    "prepublishOnly": "npm run typecheck &&npm run build && npm run obfuscate && npm run copy-files",
    "prepack": "npm run typecheck",
    "kicad-symbols": "node dist/kicad-symbols/cli/bin.js",
    "kicad2typecad": "node dist/kicad2typecad/bin.js",
    "make": "npx tsx --",
    "package_publish": "npm run prepublishOnly && npm publish --access public",
    "publish:private": "npm publish --tag private --registry http://192.168.2.207:4873/",
    "make_docs": "npx typedoc --plugin typedoc-plugin-markdown --flattenOutputFiles true --out ./docs ./src/index.ts",
    "dev": "node watch.js",
    "test": "vitest run",
    "test:routing": "vitest run --config vitest.config.routing.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "typeCAD",
  "license": "EULA",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "cpy-cli": "^6.0.0",
    "javascript-obfuscator": "^4.1.0",
    "nodemon": "^3.1.0",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.7",
    "typedoc-plugin-markdown": "^4.7.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "inquirer-file-selector": "^1.0.1",
    "inquirer-select-pro": "1.0.0-alpha.9"
  }
}
