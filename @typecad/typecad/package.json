{
  "name": "@typecad/typecad",
  "version": "0.2.24",
  "description": "🤖programmatically 💥create 🛰️hardware",
  "keywords": [
    "kicad",
    "typescript",
    "schematic",
    "ee",
    "electrical design",
    "code-as-schematic",
    "typecad"
  ],
  "homepage": "https://typecad.net",
  "funding": "https://www.buymeacoffee.com/typecad",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "create-typecad": "./cli/create-typecad/index.js",
    "add-component": "./cli/add-component/index.js",
    "add-package": "./cli/add-package/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "obfuscate": "javascript-obfuscator dist --output dist-obfuscated --config obfuscator.config.json",
    "obfuscate:strong": "javascript-obfuscator dist --output dist-obfuscated --config obfuscator.strong.config.json",
    "copy-files": "cpy \"dist-obfuscated/**/*\" dist --parents",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run obfuscate && npm run copy-files",
    "prepack": "npm run typecheck && npm test",
    "make": "npx tsx --",
    "package_publish": "npm run prepublishOnly && npm publish --access public",
    "publish:private": "npm publish --tag private --registry http://192.168.2.207:4873/",
    "make_docs": "npx typedoc --plugin typedoc-plugin-markdown --flattenOutputFiles true --out ./docs ./src/index.ts",
    "dev": "node watch.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "typeCAD",
  "license": "EULA",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "cpy-cli": "^6.0.0",
    "javascript-obfuscator": "^4.1.0",
    "nodemon": "^3.1.0",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.7",
    "typedoc-plugin-markdown": "^4.7.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "fast-sexpr": "^1.0.0",
    "find-bin": "^1.1.0",
    "handlebars": "^4.7.8",
    "s-expression.js": "^0.6.4",
    "kipm": "^0.1.0"
  }
}
