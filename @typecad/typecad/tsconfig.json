{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
    "stripInternal": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@typecad/typecad-astar": ["./src/types/typecad-astar.d.ts"]
    },
    "typeRoots": ["./src/types/", "./node_modules/@types"]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-obfuscated", "src/gitdiff/viewer"]
}
