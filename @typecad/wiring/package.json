{
  "name": "@typecad/wiring",
  "version": "0.2.0-alpha.1",
  "description": "🤖 Programmatically 💥 Create 🪢 Wiring Diagrams",
  "keywords": [
    "typecad",
    "wiring",
    "wiring diagram",
    "wiring harness",
    "harness",
    "cli"
  ],
  "author": "typeCAD",
  "license": "Apache-2.0",
  "homepage": "https://typecad.net",
  "funding": "https://www.buymeacoffee.com/typecad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typecad/wiring.git"
  },
  "bugs": {
    "url": "https://github.com/typecad/wiring/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "typecad-wiring": "./dist/cli/bin.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsc && node dist/cli/bin.js demo/wiring.ts --out demo/output --bom --cutlist",
    "prepublishOnly": "npm run typecheck && npm run build",
    "package_publish": "npm publish --access public",
    "publish:private": "npm publish --tag private --registry http://192.168.2.207:4873/"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
