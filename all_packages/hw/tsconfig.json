{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "typecad-language-plugin"
      }
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build"]
}
