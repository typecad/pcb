(export (version "E")
  (design
    (tool "typeCAD"))
  (components
    (comp
      (ref "R1")
        (value "1kohm")
        (footprint "Resistor_SMD:R_0603_1608Metric")
        (fields
                  (field (name "Footprint") "Resistor_SMD:R_0603_1608Metric")
        )
     )
    (comp
      (ref "R2")
        (value "10kohm")
        (footprint "Resistor_SMD:R_0603_1608Metric")
        (fields
                  (field (name "Footprint") "Resistor_SMD:R_0603_1608Metric")
        )
     )
    (comp
      (ref "R3")
        (value "4.7kohm")
        (footprint "Resistor_SMD:R_0603_1608Metric")
        (fields
                  (field (name "Footprint") "Resistor_SMD:R_0603_1608Metric")
        )
     ))
  (nets
    (net (code "1") (name "VCC")
        (node (ref "R1") (pin "1") (pintype "power_out"))
)
(net (code "2") (name "GND")
        (node (ref "R2") (pin "2") (pintype "power_in"))
)
(net (code "3") (name "vdiv")
        (node (ref "R1") (pin "2") (pintype "passive"))
        (node (ref "R2") (pin "1") (pintype "passive"))
)
))
