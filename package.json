{
  "name": "typecad-workspace",
  "private": true,
  "scripts": {
    "build": "npm run build --ws --if-present",
    "build:watch": "npm run build:watch -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "test:coverage": "npm run test:coverage -ws --if-present",
    "format": "prettier --write \"**/*/src/**/*.ts\"",
    "format:check": "prettier --check \"**/*/src/**/*.ts\"",
    "lint": "eslint \"**/*/src/**/*.ts\" \"**/*/*.ts\" --ignore-pattern \"**/*/node_modules/**\" --ignore-pattern \"**/*/dist/**\" --ignore-pattern \"**/*/examples/**\"",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "node scripts/release.mjs --publish-only",
    "release": "node scripts/release.mjs"
  },
  "workspaces": [
    "@typecad/*",
    "packages/*",
    "demo/hw",
    "demo/spice/hw",
    "demo/rd_skeleton/hw"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "cookie": "^1.0.0",
    "glob": "^14.0.6",
    "katex": "^0.19.1",
    "minimatch": "^11.0.9",
    "pdf2json": "^4.0.3"
  }
}
