{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": false,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "removeComments": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/gitdiff/viewer", "**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"]
}
